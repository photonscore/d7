<?xml version="1.0" encoding="utf-8"?>
<!-- An example: examples\$(ProjectName).cc, linked against libd7, or
     against photonscore_d7.dll when the name ends in _c_api. -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <D7CApi>$(ProjectName.EndsWith('_c_api'))</D7CApi>
  </PropertyGroup>

  <ItemDefinitionGroup Condition="'$(D7CApi)' == 'true'">
    <ClCompile>
      <PreprocessorDefinitions>PSCR_D7_IMPORT;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="..\examples\$(ProjectName).cc" />
  </ItemGroup>

  <ItemGroup Condition="'$(D7CApi)' != 'true'">
    <ProjectReference Include="d7.vcxproj">
      <Project>{6B1D2A8E-3C47-4F59-9E21-7D0A5C3B1E01}</Project>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup Condition="'$(D7CApi)' == 'true'">
    <ProjectReference Include="photonscore_d7.vcxproj">
      <Project>{6B1D2A8E-3C47-4F59-9E21-7D0A5C3B1E02}</Project>
    </ProjectReference>
  </ItemGroup>

</Project>
