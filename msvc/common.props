<?xml version="1.0" encoding="utf-8"?>
<!-- Shared by every project in d7.sln; imported after Microsoft.Cpp.props. -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <D7Root>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..'))</D7Root>
    <OutDir>$(D7Root)out\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(D7Root)out\obj\$(Platform)\$(Configuration)\$(ProjectName)\</IntDir>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <AdditionalOptions>/utf-8 /bigobj /Zc:__cplusplus %(AdditionalOptions)</AdditionalOptions>
      <AdditionalIncludeDirectories>$(D7Root);$(D7Root)gen;$(D7Root)third_party\fmt;$(D7Root)third_party\oneTBB\include;$(D7Root)third_party\protobuf\src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- NOMINMAX and the CRT ones: Bazel's MSVC defaults, which the
           sources grew up with -->
      <PreprocessorDefinitions>__TBB_NO_IMPLICIT_LINKAGE;NOMINMAX;_CRT_SECURE_NO_WARNINGS;_CRT_NONSTDC_NO_DEPRECATE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <WarningLevel>Level3</WarningLevel>
      <!-- size_t narrowing, all over the sources; gcc and clang stay quiet -->
      <DisableSpecificWarnings>4267;%(DisableSpecificWarnings)</DisableSpecificWarnings>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)' == 'Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)' == 'Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <Target Name="D7CheckConfigured" BeforeTargets="PrepareForBuild"
          Condition="!Exists('$(D7Root)gen\photonscore\proto\base.pb.cc')">
    <Error Text="gen\ is missing: run `python configure.py` first" />
  </Target>

</Project>
